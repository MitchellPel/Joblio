# Copy to .env.selfhost (never commit secrets)

# Office LAN (preferred when reachable — silent)
JOBLIO_LAN_API_URL=http://192.168.1.10:8080

# Public tunnel bootstrap (ngrok). Used when LAN is unreachable.
JOBLIO_BOOTSTRAP_URL=https://your-tunnel.ngrok-free.dev
JOBLIO_API_URL=https://your-tunnel.ngrok-free.dev

# Must match server X-Joblio-Key
JOBLIO_API_KEY=paste-from-server

JOBLIO_PROOFS_DIR=\\SERVER\Share\proofs
