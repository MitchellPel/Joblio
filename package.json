{
  "name": "signage-job-tracker",
  "version": "0.4.25",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Windows desktop job tracker for sign shops. Electron + React. One PC, no server.",
  "author": "Mitchell Pel",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:selfhost": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:selfhost\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5174 && tsc -p electron/tsconfig.json && cross-env-shell VITE_DEV_SERVER_URL=http://localhost:5174 \"electron .\"",
    "dev:electron:selfhost": "wait-on tcp:5174 && tsc -p electron/tsconfig.json && cross-env-shell JOBLIO_DATA_BACKEND=selfhost VITE_DEV_SERVER_URL=http://localhost:5174 \"electron .\"",
    "build": "tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync(require('path').join('node_modules','sql.js','dist','sql-wasm.wasm'), require('path').join('dist-electron','db','sql-wasm.wasm'))\" && vite build",
    "preview": "vite preview",
    "dist": "python scripts/generate-windows-icon.py && npm run build && electron-builder --win",
    "publish:share": "node scripts/publish-to-share.mjs",
    "publish:github": "node scripts/publish-github-release.mjs",
    "release": "npm run dist && npm run publish:share && npm run publish:github",
    "lint": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit && node scripts/check-office-fallbacks.mjs",
    "migrate:selfhost": "node scripts/migrate-sqlite-to-selfhost.mjs"
  },
  "build": {
    "appId": "com.signageco.jobtracker",
    "productName": "Joblio",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "publish": {
      "provider": "generic",
      "url": "file://///server/D/Joblio DB/Jobtracker/updates/"
    }
  },
  "dependencies": {
    "@hello-pangea/dnd": "^16.6.0",
    "bcryptjs": "^2.4.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sql.js": "^1.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.7.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
